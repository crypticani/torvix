{
  "title": "CloudPulse API FinOps Overview",
  "uid": "cloudpulse-rolling-finops-overview",
  "schemaVersion": 39,
  "version": 7,
  "refresh": "1h",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current 30-Day Spend",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "CloudPulseAPI" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/v1/dashboard/overview",
          "root_selector": "data",
          "root_is_not_array": true,
          "columns": [
            { "selector": "current_30_day_spend", "text": "current_30_day_spend", "type": "number" },
            { "selector": "percentage_change", "text": "percentage_change", "type": "number" }
          ]
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Previous 30-Day Spend",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "CloudPulseAPI" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/v1/dashboard/overview",
          "root_selector": "data",
          "root_is_not_array": true,
          "columns": [
            { "selector": "previous_30_day_spend", "text": "previous_30_day_spend", "type": "number" }
          ]
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Anomalies",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "CloudPulseAPI" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/v1/dashboard/overview",
          "root_selector": "data",
          "root_is_not_array": true,
          "columns": [
            { "selector": "anomaly_count", "text": "anomaly_count", "type": "number" }
          ]
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ingestion Failures",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "round(sum(increase(cloudpulse_ingestion_failures_total[$__range])))", "instant": true, "refId": "A" }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Daily Cost Trend",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "CloudPulseAPI" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "time_series",
          "url": "/api/v1/dashboard/cost-timeseries?window=daily&from=${__from:date:YYYY-MM-DD}&to=${__to:date:YYYY-MM-DD}",
          "root_selector": "data",
          "columns": [
            { "selector": "time", "text": "time", "type": "timestamp" },
            { "selector": "value", "text": "value", "type": "number" },
            { "selector": "metric", "text": "metric", "type": "string" }
          ]
        }
      ],
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Collector Runs",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(cloudpulse_collector_runs_total) by (provider, status)", "legendFormat": "{{provider}} {{status}}", "refId": "A" }
      ],
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 4 }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top Services",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "CloudPulseAPI" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/v1/dashboard/cost-by-service?from=${__from:date:YYYY-MM-DD}&to=${__to:date:YYYY-MM-DD}&limit=15",
          "root_selector": "data",
          "columns": [
            { "selector": "rank", "text": "rank", "type": "number" },
            { "selector": "provider", "text": "provider", "type": "string" },
            { "selector": "name", "text": "service", "type": "string" },
            { "selector": "total_cost", "text": "total_cost", "type": "number" }
          ]
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Cost By Category",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "CloudPulseAPI" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/v1/dashboard/cost-by-category?from=${__from:date:YYYY-MM-DD}&to=${__to:date:YYYY-MM-DD}",
          "root_selector": "data",
          "columns": [
            { "selector": "rank", "text": "rank", "type": "number" },
            { "selector": "name", "text": "category", "type": "string" },
            { "selector": "total_cost", "text": "total_cost", "type": "number" }
          ]
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Cost By Provider",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "CloudPulseAPI" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/v1/dashboard/cost-by-provider?from=${__from:date:YYYY-MM-DD}&to=${__to:date:YYYY-MM-DD}",
          "root_selector": "data",
          "columns": [
            { "selector": "rank", "text": "rank", "type": "number" },
            { "selector": "name", "text": "provider", "type": "string" },
            { "selector": "total_cost", "text": "total_cost", "type": "number" }
          ]
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Anomaly Table",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "CloudPulseAPI" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/v1/dashboard/anomalies?from=${__from:date:YYYY-MM-DD}&to=${__to:date:YYYY-MM-DD}",
          "root_selector": "data",
          "columns": [
            { "selector": "period_start", "text": "period_start", "type": "timestamp" },
            { "selector": "provider", "text": "provider", "type": "string" },
            { "selector": "service", "text": "service", "type": "string" },
            { "selector": "observed_cost", "text": "observed_cost", "type": "number" },
            { "selector": "expected_cost", "text": "expected_cost", "type": "number" },
            { "selector": "percentage_delta", "text": "percentage_delta", "type": "number" },
            { "selector": "severity", "text": "severity", "type": "string" },
            { "selector": "explanation", "text": "explanation", "type": "string" }
          ]
        }
      ],
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Latest Billing Period Status",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "CloudPulseAPI" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/v1/dashboard/ingestion-status",
          "root_selector": "data.providers",
          "columns": [
            { "selector": "provider", "text": "provider", "type": "string" },
            { "selector": "last_successful_ingestion_at", "text": "last_successful_ingestion_at", "type": "timestamp" },
            { "selector": "latest_report_processed_at", "text": "latest_report_processed_at", "type": "timestamp" },
            { "selector": "files_processed", "text": "files_processed", "type": "number" },
            { "selector": "records_processed", "text": "records_processed", "type": "number" },
            { "selector": "last_status", "text": "last_status", "type": "string" }
          ]
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 21 }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Avg Ingestion Duration",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(increase(cloudpulse_ingestion_duration_seconds_sum[$__range])) / sum(increase(cloudpulse_ingestion_duration_seconds_count[$__range]))", "instant": true, "refId": "A" }
      ],
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 29 },
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Files Processed",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "round(sum(increase(cloudpulse_processed_files_total{status=\"processed\"}[$__range])))", "instant": true, "refId": "A" }
      ],
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 29 }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Records Inserted",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "round(sum(increase(cloudpulse_processed_records_total[$__range])))", "instant": true, "refId": "A" }
      ],
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 29 }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Skipped Old Files",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "round(sum(increase(cloudpulse_processed_files_total{status=\"skipped_old\"}[$__range])))", "instant": true, "refId": "A" }
      ],
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 29 }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Records Pruned",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "round(sum(increase(cloudpulse_records_deleted_total[$__range])))", "instant": true, "refId": "A" }
      ],
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 29 }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Compressed Chunks",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "round(sum(increase(cloudpulse_compressed_chunks_total[$__range])))", "instant": true, "refId": "A" }
      ],
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 29 }
    }
  ]
}
