    {
      "id": 4,
      "type": "stat",
      "title": "Ingestion Failures",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "round(sum(increase(cloudpulse_ingestion_failures_total[$__range]))) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
