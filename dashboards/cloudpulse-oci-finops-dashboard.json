{
  "title": "CloudPulse OCI FinOps Dashboard",
  "uid": "cloudpulse-oci-finops-dashboard",
  "schemaVersion": 39,
  "version": 16,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total OCI Cost",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "CloudPulseAPI"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/v1/dashboard/oci-cost-summary?from=${__from:date:iso}&to=${__to:date:iso}&region=${region}&compartment=${compartment}&service=${service}",
          "url_options": {
            "data": "",
            "method": "GET"
          },
          "root_selector": "data",
          "columns": [
            {
              "selector": "total_cost",
              "text": "total_cost",
              "type": "number"
            }
          ],
          "root_is_not_array": true
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
