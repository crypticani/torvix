      "timeFrom": "30d",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "CloudPulseAPI"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/v1/dashboard/overview?provider=oci",
          "url_options": {
            "data": "",
            "method": "GET"
          },
          "root_selector": "data",
          "root_is_not_array": true,
          "columns": [
            {
              "selector": "current_30_day_spend",
              "text": "current_30_day_spend",
              "type": "number"
            }
          ]
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
