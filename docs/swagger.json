{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Multi-cloud FinOps cost analytics platform. Collects daily billing data from AWS, Azure, GCP, and OCI, normalises it into a canonical schema, and provides precomputed cost summaries, deterministic anomaly detection, forecasting, and automated reporting.",
        "title": "CloudPulse API",
        "contact": {
            "name": "CloudPulse Team"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/analytics/anomalies": {
            "get": {
                "description": "Analyses cost data over a time range and returns any detected anomalies with severity, z-score, and deviation metrics.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Analytics"
                ],
                "summary": "Detect cost anomalies",
                "parameters": [
                    {
                        "type": "string",
                        "example": "2025-01-01",
                        "description": "Start date (YYYY-MM-DD). Defaults to 30 days ago.",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2025-01-31",
                        "description": "End date (YYYY-MM-DD). Defaults to today.",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Detected anomalies",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_crypticani_cloudpulse_internal_domain.Anomaly"
                            }
                        }
                    },
                    "500": {
                        "description": "Detection failed",
                        "schema": {
                            "$ref": "#/definitions/internal_ports_http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/analytics/forecast": {
            "get": {
                "description": "Generates a 7-day cost forecast based on historical data within the specified time range.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Forecasting"
                ],
                "summary": "Get cost forecast",
                "parameters": [
                    {
                        "type": "string",
                        "example": "2025-01-01",
                        "description": "Start date (YYYY-MM-DD). Defaults to 30 days ago.",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2025-01-31",
                        "description": "End date (YYYY-MM-DD). Defaults to today.",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Forecast data points",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_crypticani_cloudpulse_internal_domain.ForecastPoint"
                            }
                        }
                    },
                    "500": {
                        "description": "Forecast generation failed",
                        "schema": {
                            "$ref": "#/definitions/internal_ports_http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/analytics/summary": {
            "get": {
                "description": "Returns aggregated cost data over a time range, grouped by the specified window (daily, weekly, or monthly).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Analytics"
                ],
                "summary": "Get cost summary",
                "parameters": [
                    {
                        "type": "string",
                        "example": "2025-01-01",
                        "description": "Start date (YYYY-MM-DD). Defaults to 30 days ago.",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2025-01-31",
                        "description": "End date (YYYY-MM-DD). Defaults to today.",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "daily",
                            "weekly",
                            "monthly"
                        ],
                        "type": "string",
                        "default": "daily",
                        "description": "Aggregation window: daily, weekly, or monthly.",
                        "name": "window",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cost aggregation results",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_crypticani_cloudpulse_internal_domain.AggregatedCost"
                            }
                        }
                    },
                    "500": {
                        "description": "Aggregation failed",
                        "schema": {
                            "$ref": "#/definitions/internal_ports_http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/ingest": {
            "post": {
                "description": "Queues collection of billing data from all enabled cloud providers within the configured rolling ingestion window and returns immediately. Completion is available through the returned status URL and enabled alerting targets.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Ingestion"
                ],
                "summary": "Trigger billing data ingestion",
                "responses": {
                    "202": {
                        "description": "Ingestion queued for background processing",
                        "schema": {
                            "$ref": "#/definitions/internal_ports_http.IngestAcceptedResponse"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "Ingestion service unavailable",
                        "schema": {
                            "$ref": "#/definitions/internal_ports_http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/ingest/status/{job_id}": {
            "get": {
                "description": "Returns the current or completed status for a background ingestion job.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Ingestion"
                ],
                "summary": "Get ingestion job status",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Ingestion job ID",
                        "name": "job_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Ingestion job status",
                        "schema": {
                            "$ref": "#/definitions/internal_ports_http.IngestionJobResponse"
                        }
                    },
                    "404": {
                        "description": "Ingestion job not found",
                        "schema": {
                            "$ref": "#/definitions/internal_ports_http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/reports/daily": {
            "get": {
                "description": "Builds a daily cost report including summary, anomalies, and forecast. Optionally delivers via configured webhooks.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Reports"
                ],
                "summary": "Generate daily report",
                "parameters": [
                    {
                        "type": "string",
                        "example": "2025-01-01",
                        "description": "Start date (YYYY-MM-DD). Defaults to 30 days ago.",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2025-01-31",
                        "description": "End date (YYYY-MM-DD). Defaults to today.",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "true",
                            "false"
                        ],
                        "type": "string",
                        "default": "false",
                        "description": "Set to 'true' to send report via webhooks.",
                        "name": "deliver",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Daily report",
                        "schema": {
                            "$ref": "#/definitions/github_com_crypticani_cloudpulse_internal_domain.Report"
                        }
                    },
                    "500": {
                        "description": "Report generation failed",
                        "schema": {
                            "$ref": "#/definitions/internal_ports_http.ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "Webhook delivery failed",
                        "schema": {
                            "$ref": "#/definitions/internal_ports_http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/reports/monthly": {
            "get": {
                "description": "Builds a monthly cost report including summary, anomalies, and forecast. Optionally delivers via configured webhooks.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Reports"
                ],
                "summary": "Generate monthly report",
                "parameters": [
                    {
                        "type": "string",
                        "example": "2025-01-01",
                        "description": "Start date (YYYY-MM-DD). Defaults to 30 days ago.",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2025-01-31",
                        "description": "End date (YYYY-MM-DD). Defaults to today.",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "true",
                            "false"
                        ],
                        "type": "string",
                        "default": "false",
                        "description": "Set to 'true' to send report via webhooks.",
                        "name": "deliver",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Monthly report",
                        "schema": {
                            "$ref": "#/definitions/github_com_crypticani_cloudpulse_internal_domain.Report"
                        }
                    },
                    "500": {
                        "description": "Report generation failed",
                        "schema": {
                            "$ref": "#/definitions/internal_ports_http.ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "Webhook delivery failed",
                        "schema": {
                            "$ref": "#/definitions/internal_ports_http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/reports/weekly": {
            "get": {
                "description": "Builds a weekly cost report including summary, anomalies, and forecast. Optionally delivers via configured webhooks.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Reports"
                ],
                "summary": "Generate weekly report",
                "parameters": [
                    {
                        "type": "string",
                        "example": "2025-01-01",
                        "description": "Start date (YYYY-MM-DD). Defaults to 30 days ago.",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2025-01-31",
                        "description": "End date (YYYY-MM-DD). Defaults to today.",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "true",
                            "false"
                        ],
                        "type": "string",
                        "default": "false",
                        "description": "Set to 'true' to send report via webhooks.",
                        "name": "deliver",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Weekly report",
                        "schema": {
                            "$ref": "#/definitions/github_com_crypticani_cloudpulse_internal_domain.Report"
                        }
                    },
                    "500": {
                        "description": "Report generation failed",
                        "schema": {
                            "$ref": "#/definitions/internal_ports_http.ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "Webhook delivery failed",
                        "schema": {
                            "$ref": "#/definitions/internal_ports_http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Returns the health status of the CloudPulse API server.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "Service is healthy",
                        "schema": {
                            "$ref": "#/definitions/internal_ports_http.StatusResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_crypticani_cloudpulse_internal_domain.AggregatedCost": {
            "type": "object",
            "properties": {
                "account_id": {
                    "type": "string"
                },
                "provider": {
                    "$ref": "#/definitions/github_com_crypticani_cloudpulse_internal_domain.Provider"
                },
                "service": {
                    "type": "string"
                },
                "total_cost": {
                    "type": "number"
                },
                "window_end": {
                    "type": "string"
                },
                "window_start": {
                    "type": "string"
                }
            }
        },
        "github_com_crypticani_cloudpulse_internal_domain.Anomaly": {
            "type": "object",
            "properties": {
                "account_id": {
                    "type": "string"
                },
                "actual": {
                    "type": "number"
                },
                "baseline": {
                    "type": "number"
                },
                "date": {
                    "type": "string"
                },
                "moving_average_delta": {
                    "type": "number"
                },
                "percent_deviation": {
                    "type": "number"
                },
                "provider": {
                    "$ref": "#/definitions/github_com_crypticani_cloudpulse_internal_domain.Provider"
                },
                "service": {
                    "type": "string"
                },
                "severity": {
                    "type": "string"
                },
                "z_score": {
                    "type": "number"
                }
            }
        },
        "github_com_crypticani_cloudpulse_internal_domain.ForecastPoint": {
            "type": "object",
            "properties": {
                "account_id": {
                    "type": "string"
                },
                "confidence_high": {
                    "type": "number"
                },
                "confidence_low": {
                    "type": "number"
                },
                "date": {
                    "type": "string"
                },
                "forecast_cost": {
                    "type": "number"
                },
                "provider": {
                    "$ref": "#/definitions/github_com_crypticani_cloudpulse_internal_domain.Provider"
                },
                "service": {
                    "type": "string"
                }
            }
        },
        "github_com_crypticani_cloudpulse_internal_domain.Provider": {
            "type": "string",
            "enum": [
                "aws",
                "azure",
                "gcp",
                "oci"
            ],
            "x-enum-varnames": [
                "ProviderAWS",
                "ProviderAzure",
                "ProviderGCP",
                "ProviderOCI"
            ]
        },
        "github_com_crypticani_cloudpulse_internal_domain.Report": {
            "type": "object",
            "properties": {
                "anomalies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/github_com_crypticani_cloudpulse_internal_domain.Anomaly"
                    }
                },
                "forecast": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/github_com_crypticani_cloudpulse_internal_domain.ForecastPoint"
                    }
                },
                "generated": {
                    "type": "string"
                },
                "period": {
                    "type": "string"
                },
                "summary": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/github_com_crypticani_cloudpulse_internal_domain.AggregatedCost"
                    }
                }
            }
        },
        "internal_ports_http.ErrorResponse": {
            "description": "Error response returned when an operation fails.",
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "internal server error"
                }
            }
        },
        "internal_ports_http.IngestAcceptedResponse": {
            "description": "Response returned when ingestion has been queued for background processing.",
            "type": "object",
            "properties": {
                "job_id": {
                    "type": "string",
                    "example": "1760000000000000000"
                },
                "message": {
                    "type": "string",
                    "example": "ingestion queued and running in the background"
                },
                "queued_at": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "example": "queued"
                },
                "status_url": {
                    "type": "string",
                    "example": "/api/v1/ingest/status/1760000000000000000"
                }
            }
        },
        "internal_ports_http.IngestionJobResponse": {
            "description": "Current or completed background ingestion job status.",
            "type": "object",
            "properties": {
                "completed_at": {
                    "type": "string"
                },
                "days": {
                    "type": "integer",
                    "example": 30
                },
                "duration_seconds": {
                    "type": "number",
                    "example": 12.4
                },
                "error": {
                    "type": "string",
                    "example": ""
                },
                "job_id": {
                    "type": "string",
                    "example": "1760000000000000000"
                },
                "queued_at": {
                    "type": "string"
                },
                "results": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_ports_http.IngestResponse"
                    }
                },
                "since": {
                    "type": "string"
                },
                "started_at": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "example": "running"
                }
            }
        },
        "internal_ports_http.IngestResponse": {
            "description": "Per-provider ingestion result with metrics.",
            "type": "object",
            "properties": {
                "duration_seconds": {
                    "type": "number",
                    "example": 12.4
                },
                "error": {
                    "type": "string",
                    "example": ""
                },
                "files_processed": {
                    "type": "integer",
                    "example": 5
                },
                "files_skipped": {
                    "type": "integer",
                    "example": 2
                },
                "provider": {
                    "type": "string",
                    "example": "oci"
                },
                "records_parsed": {
                    "type": "integer",
                    "example": 1234
                },
                "records_within_lookback": {
                    "type": "integer",
                    "example": 1200
                },
                "records_skipped_old": {
                    "type": "integer",
                    "example": 34
                },
                "records_inserted": {
                    "type": "integer",
                    "example": 1200
                },
                "skipped_old_files": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "internal_ports_http.StatusResponse": {
            "description": "Generic status response for operations.",
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        }
    }
}
