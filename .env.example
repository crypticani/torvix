TORVIX_IMAGE=torvix:latest
TORVIX_HTTP_PORT=8080
TORVIX_LOG_LEVEL=info
TORVIX_LOG_DIR=/app/logs
TORVIX_LOG_RETENTION_DAYS=14
TORVIX_REPORT_TIMEZONE=Asia/Kolkata
TORVIX_DAILY_REPORT_CRON="0 14 * * *"
TORVIX_WEEKLY_REPORT_CRON="0 15 * * 1"
TORVIX_REPORT_REQUIRE_COMPLETE_INGESTION=true
TORVIX_DAILY_REPORT_TARGET_LAG_DAYS=1
TORVIX_AWS_ENABLED=false
TORVIX_AWS_INGESTION_MODE=cur_s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TORVIX_AWS_CUR_BUCKET=
TORVIX_AWS_CUR_PREFIX=
TORVIX_AWS_CUR_REGION=us-east-1
TORVIX_AWS_CUR_FORMAT=csv_gzip
TORVIX_AWS_CUR_LOOKBACK_DAYS=3
TORVIX_AWS_CUR_REPORT_LAG_DAYS=2
TORVIX_AWS_CUR_LOCAL_PATH=
TORVIX_AWS_COST_METRIC=UnblendedCost
TORVIX_AWS_LOOKBACK_DAYS=3
TORVIX_AWS_REPORT_LAG_DAYS=2
TORVIX_CPU_LIMIT=1.0
TORVIX_MEMORY_LIMIT=512M

POSTGRES_DB=torvix
POSTGRES_USER=torvix
POSTGRES_PASSWORD=replace_with_password
